{
  "name": "frame-inventory-bff",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "npm run generate && tsc && mkdir -p dist/proto && cp ../backend/src/main/proto/frameinventory/v1/frames.proto ../backend/src/main/proto/frameinventory/v1/inventory_import.proto dist/proto/",
    "generate": "proto-loader-gen-types --longs=String --enums=String --defaults --grpcLib=@grpc/grpc-js --outDir=src/generated ../backend/src/main/proto/frameinventory/v1/frames.proto ../backend/src/main/proto/frameinventory/v1/inventory_import.proto && npm run codegen",
    "codegen": "graphql-codegen --config codegen.yml",
    "start": "node dist/index.js",
    "test": "npm run generate && tsc --project tsconfig.test.json && jest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "@graphql-tools/load-files": "^8.0.10",
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-prometheus": "^0.301.2",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@sentry/node": "^11.19.0",
    "cockatiel": "^3.2.1",
    "graphql": "^16.11.0",
    "pino": "^10.4.0",
    "protobufjs": "^7.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@graphql-codegen/cli": "^8.0.0",
    "@graphql-codegen/typescript": "^7.0.1",
    "@graphql-codegen/typescript-resolvers": "^7.0.1",
    "@jest/globals": "^30.5.2",
    "@types/node": "^22.0.0",
    "eslint": "^10.15.0",
    "jest": "^30.5.2",
    "prettier": "^3.10.1",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.74.0"
  },
  "overrides": {
    "@apollo/server": {
      "@graphql-tools/utils": "12.0.2"
    }
  },
  "jest": {
    "injectGlobals": false,
    "watchman": false,
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    }
  },
  "prettier": {
    "semi": false,
    "singleQuote": true
  }
}
