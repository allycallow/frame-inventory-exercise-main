{
  "uid": "frame-inventory-bff",
  "title": "Frame Inventory BFF",
  "description": "GraphQL traffic, errors, latency, and saturation for the Apollo BFF.",
  "tags": [
    "frame-inventory",
    "bff"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Completed GraphQL requests per second by operation type.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation_type) (rate(bff_graphql_request_duration_seconds_count{job=\"frame-inventory-bff\"}[$__rate_interval]))",
          "legendFormat": "{{operation_type}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Error rate",
      "description": "Percentage of GraphQL requests containing errors, including responses with HTTP 200. The panel is blank when there is no traffic.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(bff_graphql_request_duration_seconds_count{job=\"frame-inventory-bff\",outcome=\"error\"}[$__rate_interval])) or 0 * sum(rate(bff_graphql_request_duration_seconds_count{job=\"frame-inventory-bff\"}[$__rate_interval]))) / sum(rate(bff_graphql_request_duration_seconds_count{job=\"frame-inventory-bff\"}[$__rate_interval]))",
          "legendFormat": "GraphQL errors"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request latency",
      "description": "Apollo request duration percentiles split by response outcome.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, outcome) (rate(bff_graphql_request_duration_seconds_bucket{job=\"frame-inventory-bff\"}[$__rate_interval])))",
          "legendFormat": "p50 {{outcome}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le, outcome) (rate(bff_graphql_request_duration_seconds_bucket{job=\"frame-inventory-bff\"}[$__rate_interval])))",
          "legendFormat": "p95 {{outcome}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le, outcome) (rate(bff_graphql_request_duration_seconds_bucket{job=\"frame-inventory-bff\"}[$__rate_interval])))",
          "legendFormat": "p99 {{outcome}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "In-flight requests",
      "description": "GraphQL requests currently being processed by each BFF instance.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bff_graphql_requests_in_flight{job=\"frame-inventory-bff\"}",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Event loop utilization",
      "description": "Percentage of elapsed event loop time spent active by each BFF instance.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (instance) (rate(bff_nodejs_event_loop_time_seconds_total{job=\"frame-inventory-bff\",state=\"active\"}[$__rate_interval])) / sum by (instance) (rate(bff_nodejs_event_loop_time_seconds_total{job=\"frame-inventory-bff\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Slowest queries and mutations (p95)",
      "description": "Up to ten top-level GraphQL fields ranked by resolver latency over the selected time range. Includes upstream gRPC time.",
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "basic",
        "namePlacement": "left",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, histogram_quantile(0.95, sum by (le, operation_type, field) (increase(bff_graphql_root_field_duration_seconds_bucket{job=\"frame-inventory-bff\"}[$__range]))) >= 0)",
          "format": "time_series",
          "instant": true,
          "range": false,
          "legendFormat": "{{operation_type}} {{field}}"
        }
      ]
    }
  ]
}
