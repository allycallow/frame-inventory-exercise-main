{
  "uid": "frame-inventory-backend",
  "title": "Frame Inventory Backend",
  "description": "Request health, saturation, and business activity for the Spring Boot backend.",
  "tags": [
    "frame-inventory",
    "backend"
  ],
  "schemaVersion": 39,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Requests",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate",
      "description": "Completed HTTP requests and Frame Management gRPC calls per second. HTTP excludes Actuator endpoints.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"frame-inventory-backend\",uri!~\"/actuator(/.*)?\"}[$__rate_interval]))",
          "legendFormat": "HTTP"
        },
        {
          "refId": "B",
          "expr": "sum(rate(grpc_server_seconds_count{job=\"frame-inventory-backend\",rpc_service=\"frameinventory.v1.FrameManagement\"}[$__rate_interval]))",
          "legendFormat": "gRPC"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Error rate",
      "description": "Percentage of requests returning HTTP 5xx or gRPC non-OK. Series are blank when there is no traffic.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (sum(rate(http_server_requests_seconds_count{job=\"frame-inventory-backend\",uri!~\"/actuator(/.*)?\",status=~\"5..\"}[$__rate_interval])) or 0 * sum(rate(http_server_requests_seconds_count{job=\"frame-inventory-backend\",uri!~\"/actuator(/.*)?\"}[$__rate_interval]))) / (sum(rate(http_server_requests_seconds_count{job=\"frame-inventory-backend\",uri!~\"/actuator(/.*)?\"}[$__rate_interval])) > 0)",
          "legendFormat": "HTTP 5xx"
        },
        {
          "refId": "B",
          "expr": "100 * (sum(rate(grpc_server_seconds_count{job=\"frame-inventory-backend\",rpc_service=\"frameinventory.v1.FrameManagement\",grpc_status_code!=\"OK\"}[$__rate_interval])) or 0 * sum(rate(grpc_server_seconds_count{job=\"frame-inventory-backend\",rpc_service=\"frameinventory.v1.FrameManagement\"}[$__rate_interval]))) / (sum(rate(grpc_server_seconds_count{job=\"frame-inventory-backend\",rpc_service=\"frameinventory.v1.FrameManagement\"}[$__rate_interval])) > 0)",
          "legendFormat": "gRPC non-OK"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request duration",
      "description": "p50, p95, and p99 of completed requests, calculated from Micrometer histograms.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"frame-inventory-backend\",uri!~\"/actuator(/.*)?\"}[$__rate_interval])))",
          "legendFormat": "HTTP p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"frame-inventory-backend\",uri!~\"/actuator(/.*)?\"}[$__rate_interval])))",
          "legendFormat": "HTTP p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"frame-inventory-backend\",uri!~\"/actuator(/.*)?\"}[$__rate_interval])))",
          "legendFormat": "HTTP p99"
        },
        {
          "refId": "D",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(grpc_server_seconds_bucket{job=\"frame-inventory-backend\",rpc_service=\"frameinventory.v1.FrameManagement\"}[$__rate_interval])))",
          "legendFormat": "gRPC p50"
        },
        {
          "refId": "E",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(grpc_server_seconds_bucket{job=\"frame-inventory-backend\",rpc_service=\"frameinventory.v1.FrameManagement\"}[$__rate_interval])))",
          "legendFormat": "gRPC p95"
        },
        {
          "refId": "F",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(grpc_server_seconds_bucket{job=\"frame-inventory-backend\",rpc_service=\"frameinventory.v1.FrameManagement\"}[$__rate_interval])))",
          "legendFormat": "gRPC p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "row",
      "title": "Saturation",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "CPU utilization",
      "description": "CPU utilization reported by the JVM for the process and the system it runs on.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * process_cpu_usage{job=\"frame-inventory-backend\"}",
          "legendFormat": "Process"
        },
        {
          "refId": "B",
          "expr": "100 * system_cpu_usage{job=\"frame-inventory-backend\"}",
          "legendFormat": "System"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "JVM heap utilization",
      "description": "Heap used as a percentage of the reported heap maximum. Undefined pool maxima are excluded.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (instance) (jvm_memory_used_bytes{job=\"frame-inventory-backend\",area=\"heap\"}) / sum by (instance) (jvm_memory_max_bytes{job=\"frame-inventory-backend\",area=\"heap\"} > 0)",
          "legendFormat": "Heap used"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Database connection pool",
      "description": "Active HikariCP connections, configured capacity, and threads waiting for a connection.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "hikaricp_connections_active{job=\"frame-inventory-backend\"}",
          "legendFormat": "Active · {{pool}}"
        },
        {
          "refId": "B",
          "expr": "hikaricp_connections_max{job=\"frame-inventory-backend\"}",
          "legendFormat": "Capacity · {{pool}}"
        },
        {
          "refId": "C",
          "expr": "hikaricp_connections_pending{job=\"frame-inventory-backend\"}",
          "legendFormat": "Waiting · {{pool}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Frame inventory activity",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 10,
      "type": "stat",
      "title": "Frames created",
      "description": "Committed changes during the selected dashboard time range.",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(frame_lifecycle_changes_total{job=\"frame-inventory-backend\",operation=\"created\"}[$__range]))",
          "legendFormat": "Frames created",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 11,
      "type": "stat",
      "title": "Frames updated",
      "description": "Committed changes during the selected dashboard time range.",
      "gridPos": {
        "x": 8,
        "y": 19,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(frame_lifecycle_changes_total{job=\"frame-inventory-backend\",operation=\"updated\"}[$__range]))",
          "legendFormat": "Frames updated",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 12,
      "type": "stat",
      "title": "Frames soft-deleted",
      "description": "Committed changes during the selected dashboard time range.",
      "gridPos": {
        "x": 16,
        "y": 19,
        "w": 8,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(frame_lifecycle_changes_total{job=\"frame-inventory-backend\",operation=\"soft_deleted\"}[$__range]))",
          "legendFormat": "Frames soft-deleted",
          "instant": true,
          "range": false
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Frame changes over time",
      "description": "Committed changes during each query window.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(frame_lifecycle_changes_total{job=\"frame-inventory-backend\",operation=\"created\"}[$__rate_interval]))",
          "legendFormat": "Frames created"
        },
        {
          "refId": "B",
          "expr": "sum(increase(frame_lifecycle_changes_total{job=\"frame-inventory-backend\",operation=\"updated\"}[$__rate_interval]))",
          "legendFormat": "Frames updated"
        },
        {
          "refId": "C",
          "expr": "sum(increase(frame_lifecycle_changes_total{job=\"frame-inventory-backend\",operation=\"soft_deleted\"}[$__rate_interval]))",
          "legendFormat": "Frames soft-deleted"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Successful inventory reads",
      "description": "Successful list, detail, and history calls during each query window.",
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rpc_method) (increase(grpc_server_seconds_count{job=\"frame-inventory-backend\",rpc_service=\"frameinventory.v1.FrameManagement\",rpc_method=~\"ListFrames|GetFrame|GetFrameHistory\",grpc_status_code=\"OK\"}[$__rate_interval]))",
          "legendFormat": "{{rpc_method}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Version conflicts",
      "description": "Update and delete calls rejected with ABORTED because the supplied version is stale or the frame no longer has a current version.",
      "gridPos": {
        "x": 12,
        "y": 31,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (rpc_method) (increase(grpc_server_seconds_count{job=\"frame-inventory-backend\",rpc_service=\"frameinventory.v1.FrameManagement\",rpc_method=~\"UpdateFrame|DeleteFrame\",grpc_status_code=\"ABORTED\"}[$__rate_interval]))",
          "legendFormat": "{{rpc_method}}"
        }
      ]
    }
  ]
}
